# このファイルを .env にコピーして値を設定する（.env はコミットされない）
#   cp .env.example .env

# Google Gemini APIキー（未設定ならデモモードで動作）
# 取得：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 使用モデル（省略可）
MODEL=gemini-2.5-flash

# ポート（省略可）
PORT=3000

# 入場用の合言葉（必須。イベントごとに変更する）
PASSPHRASE=おめでとう

# トークン署名用シークレット（省略可。未設定なら起動ごとにランダム生成される。
# Cloud Run等で再デプロイしてもセッションを維持したい場合のみ、長いランダム文字列を設定）
SECRET=

# 1人あたりの発話上限（省略可）
MAX_TURNS=30
# 1人あたりの毎分発話上限（省略可）
MAX_PER_MIN=6

# ---- フリー質問での音声読み上げ（ElevenLabs）。未設定なら音声なしで文字だけ動作 ----
# APIキー：ElevenLabs のアカウント設定 → API Keys
ELEVENLABS_API_KEY=
# Voice ID：Voices → 作成した音声 → ID をコピー
ELEVENLABS_VOICE_ID=
# 使用モデル（省略可）
ELEVENLABS_MODEL=eleven_multilingual_v2

